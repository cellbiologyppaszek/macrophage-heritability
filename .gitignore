@"
# Do not upload external/raw BioImage Archive data
data/external/
external/
raw/
data/raw/

# Large raw image files
*.tif
*.tiff
*.czi
*.nd2
*.lif

# Large intermediate files
*.pkl
*.pkl.gz
*.h5
*.hdf5

# Compressed archives
*.zip
*.tar.gz
*.rar
*.7z

# Jupyter temporary files
.ipynb_checkpoints/

# Python temporary files
__pycache__/
*.pyc

# R temporary files
.Rhistory
.RData
.Rproj.user/

# System files
.DS_Store
Thumbs.db

# Local outputs
outputs/
"@ | Out-File -Encoding utf8 .gitignore